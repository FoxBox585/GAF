# Copy to .env for local runs. On Render these are set in the dashboard.
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=AIza...
TAVILY_API_KEY=tvly-...
ALLOWED_CHAT_ID=-1001234567890

# Optional:
# JOKER_BOT_TOKEN=123456:ABC-...        # the second bot; omit and only Alfred runs
# DB_PATH=/data/gaf.db                  # defaults to ./gaf.db locally
# IMAGE_MODEL=gemini-2.5-flash-image    # older Nano Banana, if your Google project isn't billed
# VISION_MODEL=gemini-2.5-flash         # reads incoming photos/PDFs; cheaper than the 3.6 default
